#!/usr/bin/env bash
# gitlogue-commits-watch — follow the AI (or anyone) in real time: every new
# commit that lands on the current branch is replayed automatically.
#
# Pause/resume inside the animation with Space, step with n/p, quit with q.
# Commits made while gitlogue is open queue up and play (oldest first) as
# soon as the current animation ends. Ctrl-C stops following.
#
# Usage:   gitlogue-commits-watch [repo-dir]
# Env:     GITLOGUE_SPEED   typing speed ms/char     (default 10)
#          GITLOGUE_QUIET   debounce seconds of calm (default 0.5)
#          GITLOGUE_LATEST  1 = replay current HEAD once at startup (default 0)
#
# Needs:   inotify-tools (pacman -S --needed inotify-tools)
set -euo pipefail

DIR="${1:-.}"
SPEED="${GITLOGUE_SPEED:-10}"
QUIET="${GITLOGUE_QUIET:-0.5}"

for bin in inotifywait gitlogue git; do
	if ! command -v "$bin" >/dev/null 2>&1; then
		echo "gitlogue-commits-watch: missing '$bin'" >&2
		[ "$bin" = inotifywait ] && echo "  install it: sudo pacman -S --needed inotify-tools" >&2
		exit 1
	fi
done

GITDIR="$(git -C "$DIR" rev-parse --absolute-git-dir)"
last="$(git -C "$DIR" rev-parse HEAD 2>/dev/null || true)"

events="$(mktemp)"
trap 'kill "$watcher" 2>/dev/null || true; rm -f "$events"' EXIT

# Only ref movements matter: HEAD (checkout/detach) and branch refs (commits).
inotifywait -m -q -e modify,close_write,create,move,delete \
	-r "$GITDIR/HEAD" "$GITDIR/refs" >>"$events" &
watcher=$!

replay() { # replay <commit-or-range>
	gitlogue --path "$DIR" --commit "$1" --order asc --background=false --speed "$SPEED"
}

if [ "${GITLOGUE_LATEST:-0}" = 1 ] && [ -n "$last" ]; then
	replay "$last"
fi

echo "following commits in $DIR (Space=pause  n/p=step  q=quit  Ctrl-C=stop following)"

while :; do
	if [ -s "$events" ]; then
		sleep "$QUIET" # debounce ref churn
		: >"$events"   # consume
		head="$(git -C "$DIR" rev-parse HEAD 2>/dev/null || printf '%s' "$last")"
		if [ -n "$head" ] && [ "$head" != "$last" ]; then
			# Everything since the last replay, oldest first; fall back to the
			# bare tip when the range is unusable (rewrite, reset, unborn HEAD).
			if ! new="$(git -C "$DIR" rev-list "$last..$head" 2>/dev/null)" || [ -z "$new" ]; then
				replay "$head"
			else
				replay "$last..$head"
			fi
			last="$head"
		fi
	else
		sleep 0.2
	fi
done